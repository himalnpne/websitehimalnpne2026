# Canonical website URL. The existing portfolio links to this domain by default.
# Change it if you publish somewhere else. No trailing slash.
SITE_URL=https://neupanehimal.com.np

# Use / for Cloudflare Pages custom domains, and /repo-name/ for GitHub project pages.
VITE_BASE_PATH=/

# Optional AdSense — leave blank until approved and ready.
# Place real values in .env.local or in Cloudflare Pages environment variables.
VITE_ADSENSE_CLIENT=
VITE_AD_SLOT_LEADERBOARD=
VITE_AD_SLOT_RECTANGLE=
VITE_AD_SLOT_INFEED=
